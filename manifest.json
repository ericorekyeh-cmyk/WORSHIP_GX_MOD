{
  "manifest_version": 1,
  "name": "Worship GX Music Mod",
  "version": "1.0.0",
  "description": "A dark neon Opera GX mod with ambient synth music and moody styling.",
  "author": "Worship GX",
  "license": "MIT",
  "icons": {
    "512": "1102902.jpg"
  },
  "mod": {
